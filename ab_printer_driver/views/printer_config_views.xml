<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ab.printer.category -->
    <record id="view_printer_category_list" model="ir.ui.view">
        <field name="name">ab.printer.category.list</field>
        <field name="model">ab.printer.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="printer_count"/>
            </list>
        </field>
    </record>

    <record id="action_printer_category" model="ir.actions.act_window">
        <field name="name">Printer Categories</field>
        <field name="res_model">ab.printer.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ab.printer.config -->
    <record id="view_printer_config_list" model="ir.ui.view">
        <field name="name">ab.printer.config.list</field>
        <field name="model">ab.printer.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="printer_mode"/>
                <field name="printer_use"/>
                <field name="vendor" optional="show"/>
                <field name="printer_ip" optional="show"/>
                <field name="printer_port" optional="hide"/>
                <field name="paper_width_mm" optional="hide"/>
                <field name="verified" widget="boolean_toggle" optional="show"/>
                <field name="last_seen" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state in ('disconnected', 'error')"
                       decoration-info="state == 'printing'"/>
            </list>
        </field>
    </record>

    <record id="view_printer_config_form" model="ir.ui.view">
        <field name="name">ab.printer.config.form</field>
        <field name="model">ab.printer.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify_connection" type="object"
                            string="Verify Connection" class="oe_highlight"/>
                    <button name="action_test_connection" type="object"
                            string="Test Print" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="disconnected,connected,printing,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Kitchen — Bar"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="category_id"/>
                            <field name="printer_use"/>
                            <field name="paper_width_mm"/>
                            <field name="vendor" readonly="1"/>
                            <field name="mac" readonly="1"/>
                            <field name="verified" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                        </group>
                        <group string="Connection">
                            <field name="printer_mode"/>
                            <field name="printer_ip"
                                   invisible="printer_mode != 'network'"/>
                            <field name="printer_port"
                                   invisible="printer_mode != 'network'"/>
                            <field name="usb_vendor_id"
                                   invisible="printer_mode != 'usb'"/>
                            <field name="usb_product_id"
                                   invisible="printer_mode != 'usb'"/>
                            <field name="bluetooth_device_name"
                                   invisible="printer_mode != 'bluetooth'"/>
                        </group>
                        <group string="Reliability" name="reliability">
                            <field name="enable_fallback"/>
                            <field name="retry_count"/>
                            <field name="timeout"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_printer_config_search" model="ir.ui.view">
        <field name="name">ab.printer.config.search</field>
        <field name="model">ab.printer.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="printer_ip"/>
                <field name="vendor"/>
                <field name="category_id"/>
                <filter string="Connected" name="connected"
                        domain="[('state', '=', 'connected')]"/>
                <filter string="Verified ESC/POS" name="verified"
                        domain="[('verified', '=', True)]"/>
                <filter string="Error" name="error"
                        domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Receipt" name="use_receipt"
                        domain="[('printer_use', 'in', ['receipt', 'both'])]"/>
                <filter string="Kitchen" name="use_kitchen"
                        domain="[('printer_use', 'in', ['kitchen', 'both'])]"/>
                <filter string="Label" name="use_label"
                        domain="[('printer_use', '=', 'label')]"/>
                <separator/>
                <group string="Group By">
                    <filter string="Category" name="g_cat"
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Use" name="g_use"
                            context="{'group_by': 'printer_use'}"/>
                    <filter string="Status" name="g_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_printer_config" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">ab.printer.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_printer_config_search"/>
    </record>

    <!-- OWL Network Scanner client action -->
    <record id="action_printer_scanner" model="ir.actions.client">
        <field name="name">Network Scanner</field>
        <field name="tag">ab_printer_driver.scanner</field>
    </record>

    <!-- OWL Print Diagnostics / Live Monitor -->
    <record id="action_print_live_monitor" model="ir.actions.client">
        <field name="name">Live Monitor</field>
        <field name="tag">ab_printer_driver.live_monitor</field>
    </record>

</odoo>

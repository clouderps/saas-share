#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_ar_aging
msgid "Receivables Aging"
msgstr "أعمار الذمم المدينة"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_ar_aging
msgid "Accounts receivable aging — total outstanding amount per bucket (not_due / 0-30 / 31-60 / 61-90 / 90+) for the allowed companies. Use for 'aging buckets', 'overdue breakdown', 'who's late paying'."
msgstr "أعمار الذمم المدينة — إجمالي المبلغ المستحق لكل فئة (غير مستحق / 0-30 / 31-60 / 61-90 / أكثر من 90) للشركات المسموح بها. استخدمها لأسئلة مثل 'فئات الأعمار' و'تفصيل المتأخرات' و'من المتأخر في السداد'."

#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_top_overdue_partners
msgid "Top Debtors"
msgstr "أكبر المدينين"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_top_overdue_partners
msgid "Top-N customers by total open (residual) receivable amount. Use for 'who owes me the most?' / 'biggest debtors'."
msgstr "أعلى العملاء من حيث إجمالي المبلغ المفتوح المستحق عليهم. استخدمها لأسئلة مثل 'من أكثر من يدين لي؟' و'أكبر المدينين'."

#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_pl_trend
msgid "Profit & Loss Trend"
msgstr "اتجاه الأرباح والخسائر"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_pl_trend
msgid "Monthly Profit & Loss trend (revenue, expenses, net profit) over the requested period. Use for 'show me my P&L by month', 'when did expenses spike'."
msgstr "اتجاه الأرباح والخسائر الشهري (الإيرادات والمصروفات وصافي الربح) خلال الفترة المطلوبة. استخدمها لأسئلة مثل 'اعرض الأرباح والخسائر شهريًا' و'متى ارتفعت المصروفات'."

#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_cashflow_daily
msgid "Daily Cash Flow"
msgstr "التدفق النقدي اليومي"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_cashflow_daily
msgid "Daily cash inflow/outflow/net across all bank and cash journals. Use for 'how much cash came in today', 'what came in this week', 'show me cash by day'."
msgstr "التدفقات النقدية الداخلة والخارجة والصافي يوميًا عبر جميع دفاتر البنوك والنقدية. استخدمها لأسئلة مثل 'كم دخل نقدًا اليوم' و'ما الذي دخل هذا الأسبوع' و'اعرض النقد حسب اليوم'."

#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_cashflow_by_journal
msgid "Cash Flow by Journal"
msgstr "التدفق النقدي حسب الدفتر"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_cashflow_by_journal
msgid "Cash inflow / outflow / net grouped by journal (Mada / Visa / Cash / Bank Transfer …). Use for 'breakdown by payment method'."
msgstr "التدفقات النقدية الداخلة والخارجة والصافي مجمعة حسب الدفتر (مدى / فيزا / نقدي / تحويل بنكي …). استخدمها لسؤال 'التفصيل حسب طريقة الدفع'."

#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_pl_summary
msgid "Profit & Loss Summary"
msgstr "ملخص الأرباح والخسائر"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_pl_summary
msgid "Profit & Loss summary for a period: revenue, expenses, net profit. Numbers in company currency."
msgstr "ملخص الأرباح والخسائر لفترة: الإيرادات والمصروفات وصافي الربح، بعملة الشركة."

#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_cash_position
msgid "Cash Position"
msgstr "المركز النقدي"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_cash_position
msgid "Current balances of all liquidity (cash and bank) journals."
msgstr "الأرصدة الحالية لجميع دفاتر السيولة (النقدية والبنوك)."

#. module: ab_ai_tools_account
#: model:ai.agent.tool,name:ab_ai_tools_account.tool_tax_summary
msgid "Tax Summary"
msgstr "ملخص الضريبة"

#. module: ab_ai_tools_account
#: model:ai.agent.tool,description:ab_ai_tools_account.tool_tax_summary
msgid "Output VAT / sales tax collected and input tax credited for a period."
msgstr "ضريبة القيمة المضافة المحصلة على المبيعات وضريبة المدخلات المستردة لفترة."


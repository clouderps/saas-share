<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="command_create_invoice" model="ai.agent.command">
            <field name="name">Create Customer Invoice</field>
            <field name="code">create_invoice</field>
            <field name="verb">create invoice</field>
            <field name="target_model">account.move</field>
            <field name="icon">fa-file-text</field>
            <field name="sequence">5</field>
            <field name="description">Draft a customer invoice. It is NOT posted — you review and post it yourself.</field>
            <field name="example">/create invoice partner: Acme; date: 3/8/26; items: 2x latte</field>
            <field name="context">{'ai_command_move_type': 'out_invoice'}</field>
            <field name="group_ids" eval="[(6, 0, [ref('account.group_account_invoice')])]"/>
        </record>

        <record id="command_create_bill" model="ai.agent.command">
            <field name="name">Create Vendor Bill</field>
            <field name="code">create_bill</field>
            <field name="verb">create bill</field>
            <field name="target_model">account.move</field>
            <field name="icon">fa-file-text-o</field>
            <field name="sequence">6</field>
            <field name="description">Draft a vendor bill. It is NOT posted — you review and post it yourself.</field>
            <field name="example">/create bill vendor: Al Faisal Supplies; items: 20x flour</field>
            <field name="context">{'ai_command_move_type': 'in_invoice'}</field>
            <field name="group_ids" eval="[(6, 0, [ref('account.group_account_invoice')])]"/>
        </record>

    </data>
</odoo>

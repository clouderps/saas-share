<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="command_create_employee" model="ai.agent.command">
            <field name="name">Create Employee</field>
            <field name="code">create_employee</field>
            <field name="verb">create employee</field>
            <field name="target_model">hr.employee</field>
            <field name="icon">fa-user-plus</field>
            <field name="sequence">30</field>
            <field name="description">Add an employee record. Contract, salary and payroll are not touched.</field>
            <field name="example">/create employee name: Abdullah Al Otaibi; job: Cashier; phone: 0501234567</field>
            <field name="group_ids" eval="[(6, 0, [ref('hr.group_hr_user')])]"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_ai" model="ir.module.category">
        <field name="name">AI Provider</field>
        <field name="description">AI provider configuration and service</field>
        <field name="sequence">95</field>
    </record>

    <!-- Security Groups -->
    <record id="group_ai_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_ai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">AI user - can use AI services but not configure them.</field>
    </record>

    <record id="group_ai_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_ai"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
        <field name="comment">AI manager - full CRUD on AI provider configurations.</field>
    </record>

    <!-- ERP Manager automatically gets AI Manager access -->
    <record id="base.group_erp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

</odoo>

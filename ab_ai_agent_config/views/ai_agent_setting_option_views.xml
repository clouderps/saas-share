<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_setting_option_list" model="ir.ui.view">
        <field name="name">ai.agent.setting.option.list</field>
        <field name="model">ai.agent.setting.option</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="field_name"/>
                <field name="group_id"/>
                <field name="warning"/>
                <field name="available"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_ai_agent_setting_option" model="ir.actions.act_window">
        <field name="name">Assistant Settings Whitelist</field>
        <field name="res_model">ai.agent.setting.option</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="command_create_leave" model="ai.agent.command">
            <field name="name">Request Time Off</field>
            <field name="code">create_leave</field>
            <field name="verb">create leave</field>
            <field name="target_model">hr.leave</field>
            <field name="icon">fa-plane</field>
            <field name="sequence">35</field>
            <field name="description">Request time off for yourself (leave / vacation / sick day). It goes to your manager for approval like any other request.</field>
            <field name="example">/create leave type: Annual Leave; from: next Sunday; to: next Tuesday</field>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
    </data>
</odoo>

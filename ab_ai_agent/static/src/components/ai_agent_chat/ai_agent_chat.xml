<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Ask AI — answer cards.

        This is not a messaging UI. The agent's job is decision support,
        reporting, and explaining the system, so a turn renders as:

            question line  (muted, small — context, not content)
            answer card    (title · sources · block-kit body · actions)

        No chat bubbles, no avatars, no typing dots — those framed the
        agent as a person to talk to rather than an answer to act on.

        The card body delegates to <AiResponse/> from ab_ai_ui: the one
        renderer every AI surface shares. This template used to
        re-implement data_table / kpi_grid / callout / highlight_list
        inline, which meant chart blocks silently rendered as nothing
        here while working everywhere else.

        RTL: the shell carries dir and every rule in the SCSS uses
        logical properties, so nothing here needs a mirrored variant.
    -->
    <t t-name="ab_ai_agent.AiAgentChat">
        <section class="o_ai_agent_chat" role="region"
                 t-att-class="{ 'is-compact': props.hideSidebar and props.surface !== 'chatter' }"
                 t-att-aria-label="headerTitle"
                 t-att-dir="isRtl ? 'rtl' : 'auto'">

            <!-- ── Header ─────────────────────────────────────────── -->
            <header class="o_ai_agent_chat__header">
                <AiAgentChip agent="activeAgent" agents="visibleAgents" onPick.bind="onAgentPick"/>
                <div class="flex-grow-1" style="min-width: 0;">
                    <p class="o_ai_agent_chat__title" t-esc="headerTitle"/>
                    <p class="o_ai_agent_chat__subtitle text-truncate" t-esc="headerSubtitle"/>
                </div>
                <!-- Floating panel: one button → a circle of chat options
                     (history, new, share, sound, full screen), opening down.
                     The full console keeps its row of buttons. -->
                <t t-if="headerCompact">
                    <t t-set="headerItems" t-value="headerActions"/>
                    <div class="o_ai_radial o_ai_radial--down" t-ref="headerRadial"
                         t-att-class="{ 'is-open': state.headerRadialOpen }"
                         t-on-keydown="onHeaderRadialKeydown">
                        <div class="o_ai_radial__menu" role="menu"
                             t-att-aria-label="labels.chatOptions"
                             t-att-aria-hidden="state.headerRadialOpen ? 'false' : 'true'">
                            <span class="o_ai_radial__center"
                                  t-esc="state.headerRadialHover or labels.chatOptions"/>
                            <button t-foreach="headerItems" t-as="item" t-key="item.id"
                                    type="button" role="menuitem" class="o_ai_radial__item"
                                    t-att-style="radialStyle(item_index, headerItems.length)"
                                    t-att-tabindex="state.headerRadialOpen ? '0' : '-1'"
                                    t-att-aria-label="item.label" t-att-title="item.label"
                                    t-on-mouseenter="() => state.headerRadialHover = item.label"
                                    t-on-focus="() => state.headerRadialHover = item.label"
                                    t-on-mouseleave="() => state.headerRadialHover = ''"
                                    t-on-click="() => this.pickHeaderAction(item)">
                                <i t-attf-class="fa #{item.icon}" aria-hidden="true"/>
                            </button>
                        </div>
                        <button type="button" class="o_ai_radial__toggle o_ai_radial__toggle--quiet"
                                aria-haspopup="menu"
                                t-att-aria-expanded="state.headerRadialOpen ? 'true' : 'false'"
                                t-att-aria-label="labels.chatOptions" t-att-title="labels.chatOptions"
                                t-on-click="toggleHeaderRadial">
                            <i class="fa fa-ellipsis-h" aria-hidden="true"/>
                        </button>
                    </div>
                </t>
                <t t-else="">
                <AiAgentTokenMeter compact="props.surface !== 'chat'"/>
                <!-- Shared with the floating bubble and Discuss: these
                     read the same ai.chat.conversation rows, so a chat
                     started in one surface is continued in another.
                     Hidden entirely when no chatbot module is installed
                     and there is therefore nothing to remember. -->
                <button t-if="state.historyAvailable"
                        class="o_ai_agent_chat__icon_btn"
                        t-att-class="{ 'is-muted': state.showHistory }"
                        type="button" t-on-click="toggleHistory"
                        t-att-title="labels.history">
                    <i class="fa fa-history"/>
                </button>
                <button t-if="state.historyAvailable"
                        class="o_ai_agent_chat__icon_btn"
                        type="button" t-on-click="startNewConversation"
                        t-att-title="labels.newChat">
                    <i class="fa fa-plus"/>
                </button>
                <!-- Share is a capability link, so revoking sits in the
                     same place as creating rather than buried. -->
                <button t-if="state.historyAvailable and state.conversationId"
                        class="o_ai_agent_chat__icon_btn"
                        t-att-class="{ 'is-muted': state.shareUrl }"
                        type="button"
                        t-on-click="() => state.shareUrl ? this.unshareConversation() : this.shareConversation()"
                        t-att-title="state.shareUrl ? labels.unshare : labels.share">
                    <i t-att-class="state.shareUrl ? 'fa fa-chain-broken' : 'fa fa-share-alt'"/>
                </button>
                <button class="o_ai_agent_chat__icon_btn"
                        t-att-class="{ 'is-muted': state.muted }"
                        t-on-click="toggleMute"
                        type="button"
                        t-att-title="state.muted ? muteLabels.off : muteLabels.on">
                    <i t-att-class="state.muted ? 'fa fa-volume-off' : 'fa fa-volume-up'"/>
                </button>
                <button t-if="props.onExpand" class="o_ai_agent_chat__icon_btn"
                        type="button" t-on-click="() => props.onExpand()"
                        t-att-title="labels.expand" t-att-aria-label="labels.expand">
                    <i class="fa fa-expand"/>
                </button>
                </t>
                <button t-if="props.onClose" class="o_ai_agent_chat__close" type="button"
                        t-on-click="close" t-att-aria-label="labels.close">
                    <i class="fa fa-times"/>
                </button>
            </header>

            <!-- ── Body ───────────────────────────────────────────── -->
            <div class="o_ai_agent_chat__body"
                 t-att-class="{ 'has-history': state.showHistory }">
                <!-- Past chats, as a column beside the conversation
                     rather than a sheet dropped over it: an overlay hid
                     the answer the user was reading in order to show
                     them a list of other answers. Grid order puts it on
                     the leading edge — left in LTR, right in RTL — with
                     no mirrored rule. -->
                <aside t-if="state.showHistory" class="o_ai_history">
                    <p class="o_ai_history__title" t-esc="labels.history"/>
                    <p t-if="!state.conversations.length" class="o_ai_history__empty"
                       t-esc="labels.noHistory"/>
                    <button t-foreach="state.conversations" t-as="conv" t-key="conv.id"
                            type="button" class="o_ai_history__item"
                            t-att-class="{ 'is-active': conv.id === state.conversationId }"
                            t-on-click="() => this.selectConversation(conv.id)">
                        <i class="fa fa-comment-o" aria-hidden="true"/>
                        <span class="o_ai_history__name text-truncate" t-esc="conv.name"/>
                        <span class="o_ai_history__count" t-esc="conv.message_count"/>
                    </button>
                </aside>

                <!-- ai-chip-pick bubbles from <SuggestionChips/> deep
                     inside an answer card, so it is caught here at the
                     stream rather than per-message. Without this every
                     clarification and write-confirmation chip in the
                     console was inert. -->
                <div class="o_ai_agent_chat__stream" t-ref="stream"
                     t-on-ai-chip-pick="onChipPick">
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.id">

                        <!-- Question: context for the answer below it,
                             deliberately quiet. -->
                        <div t-if="msg.role === 'user'" class="o_ai_answer_q">
                            <i class="fa fa-search o_ai_answer_q__icon" aria-hidden="true"/>
                            <p class="o_ai_answer_q__text" t-esc="msg.text"/>
                            <span t-if="msg.at" class="o_ai_answer_q__time" t-esc="msg.at"/>
                        </div>

                        <!-- Answer card -->
                        <article t-elif="msg.role === 'assistant'"
                                 class="o_ai_answer"
                                 t-att-class="{ 'is-collapsed': msg.collapsed }">

                            <header class="o_ai_answer__head">
                                <h3 class="o_ai_answer__title" t-esc="answerTitle(msg)"/>
                                <button t-if="msg.toolCalls and msg.toolCalls.length"
                                        class="o_ai_answer__sources"
                                        type="button"
                                        t-on-click="() => this.toggleTrace(msg)"
                                        t-att-aria-expanded="msg.showTrace ? 'true' : 'false'"
                                        t-att-title="labels.sources">
                                    <i class="fa fa-database" aria-hidden="true"/>
                                    <span t-esc="msg.toolCalls.length"/>
                                </button>
                                <button class="o_ai_answer__collapse" type="button"
                                        t-on-click="() => this.toggleCollapse(msg)"
                                        t-att-aria-label="labels.collapse">
                                    <i t-att-class="msg.collapsed ? 'fa fa-chevron-down' : 'fa fa-chevron-up'"/>
                                </button>
                            </header>

                            <div t-if="!msg.collapsed" class="o_ai_answer__body">
                                <!-- One renderer for every block type,
                                     charts included. -->
                                <AiResponse t-if="msg.envelope"
                                            envelope="msg.envelope"
                                            compact="isCompact"
                                            hideProvenance="true"/>
                                <div t-else="" class="o_ai_answer__plain" t-out="msg.text"/>

                                <AiAgentRunTrace t-if="msg.showTrace and msg.toolCalls and msg.toolCalls.length"
                                                 toolCalls="msg.toolCalls"
                                                 provenance="msg.provenance"/>
                            </div>

                            <div t-if="!msg.collapsed and msg.navChoices and msg.navChoices.length"
                                 class="o_ai_answer__choices" role="group" t-att-aria-label="labels.whichOne">
                                <button t-foreach="msg.navChoices" t-as="choice" t-key="choice_index"
                                        class="o_ai_answer__choice" type="button"
                                        t-on-click="(ev) => this.pickNavChoice(choice, ev)">
                                    <i class="fa fa-mouse-pointer" aria-hidden="true"/>
                                    <span t-esc="choice.label"/>
                                </button>
                            </div>
                            <footer t-if="!msg.collapsed" class="o_ai_answer__foot">
                                <button t-if="msg.pendingAction"
                                        class="o_ai_answer__cta"
                                        type="button"
                                        t-on-click="() => this.runEnvelopeAction(msg.pendingAction)">
                                    <i class="fa fa-external-link" aria-hidden="true"/>
                                    <span t-esc="msg.pendingAction.name || labels.open"/>
                                </button>
                                <button t-if="msg.runId" class="o_ai_answer__act" type="button"
                                        t-on-click="() => this.refine(msg)">
                                    <i class="fa fa-repeat" aria-hidden="true"/>
                                    <span t-esc="labels.refine"/>
                                </button>
                                <button t-if="tts" class="o_ai_answer__act" type="button"
                                        t-on-click="() => this.listen(msg)"
                                        t-att-aria-pressed="state.speakingId === msg.id ? 'true' : 'false'">
                                    <i t-att-class="state.speakingId === msg.id ? 'fa fa-stop' : 'fa fa-volume-up'" aria-hidden="true"/>
                                    <span t-esc="state.speakingId === msg.id ? labels.stopListening : labels.listen"/>
                                </button>
                                <span class="flex-grow-1"/>
                                <div t-if="msg.runId" class="o_ai_answer__rate">
                                    <button t-att-class="{ 'is-active': msg.feedback === 'up' }"
                                            t-on-click="() => this.rate(msg, 'up')"
                                            t-att-aria-label="labels.helpful" type="button">
                                        <i class="fa fa-thumbs-up"/>
                                    </button>
                                    <button t-att-class="{ 'is-active': msg.feedback === 'down' }"
                                            t-on-click="() => this.rate(msg, 'down')"
                                            t-att-aria-label="labels.unhelpful" type="button">
                                        <i class="fa fa-thumbs-down"/>
                                    </button>
                                </div>
                            </footer>

                            <!-- Openers, derived from what this user can
                                 actually reach — never a fixed list.
                                 Only in-card when there is no sidebar to
                                 host them, otherwise they appear twice. -->
                            <div t-if="msg.isWelcome and state.groups.length"
                                 class="o_ai_start">
                                <div t-foreach="state.groups" t-as="grp" t-key="grp.code"
                                     class="o_ai_start__group">
                                    <p class="o_ai_start__group-title" t-esc="grp.title"/>
                                    <div class="o_ai_start__group-items">
                                        <button t-foreach="grp.items" t-as="ex" t-key="ex_index"
                                                type="button" class="o_ai_start__item"
                                                t-on-click="() => this.onExamplePick(ex)">
                                            <i t-attf-class="fa {{ex.icon}}" aria-hidden="true"/>
                                            <span t-esc="ex.text"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </t>

                    <!-- Working: mirror the shape of the answer to come
                         rather than three dancing dots. -->
                    <article t-if="state.isThinking" class="o_ai_answer is-pending" aria-busy="true">
                        <header class="o_ai_answer__head">
                            <h3 class="o_ai_answer__title" t-esc="state.thinkingLabel || labels.working"/>
                        </header>
                        <div class="o_ai_answer__body">
                            <!-- Sources as they are consulted. Live from
                                 the server, so a long wait shows work
                                 rather than an unmoving spinner. -->
                            <div t-if="state.streamSteps.length" class="o_ai_stream">
                                <span t-foreach="state.streamSteps" t-as="step"
                                      t-key="step" class="o_ai_stream__step">
                                    <i class="fa fa-check" aria-hidden="true"/>
                                    <t t-esc="toolLabel(step)"/>
                                </span>
                            </div>
                            <div class="o_ai_skeleton">
                                <span class="o_ai_skeleton__kpi"/>
                                <span class="o_ai_skeleton__kpi"/>
                                <span class="o_ai_skeleton__kpi"/>
                            </div>
                            <div class="o_ai_skeleton">
                                <span class="o_ai_skeleton__row"/>
                                <span class="o_ai_skeleton__row" style="inline-size: 82%;"/>
                                <span class="o_ai_skeleton__row" style="inline-size: 64%;"/>
                            </div>
                        </div>
                    </article>
                </div>

                <aside t-if="!props.hideSidebar" class="o_ai_agent_chat__sidebar">
                    <div t-if="skills.length" class="o_ai_agent_skill_panel">
                        <p class="o_ai_agent_skill_panel__title" t-esc="labels.skills"/>
                        <AiAgentSkillCard t-foreach="skills" t-as="s" t-key="s.code"
                                          skill="s" onPick.bind="onSkillPick"/>
                    </div>
                    <div t-elif="!state.groups.length and state.starters.length"
                         class="o_ai_agent_skill_panel">
                        <p class="o_ai_agent_skill_panel__title" t-esc="labels.tryAsking"/>
                        <div class="o_ai_agent_sidebar_hints">
                            <button t-foreach="state.starters" t-as="ex" t-key="ex_index"
                                    type="button" class="o_ai_agent_sidebar_hint"
                                    t-on-click="() => this.onExamplePick(ex)">
                                <i t-attf-class="fa {{ex.icon}}" aria-hidden="true"/>
                                <span t-esc="ex.text"/>
                            </button>
                        </div>
                    </div>
                </aside>
            </div>

            <!-- ── Footer ─────────────────────────────────────────── -->
            <!-- Attach / camera are NOT here on purpose. ab_ai_agent
                 ships in saas-share and must stay free of scanner code;
                 ab_ai_chatbot depends on both this and ab_scan_docs and
                 patches them in (ai_agent_chat_attach_patch.js), which
                 also gets torch and auto-capture for free. -->
            <!-- Screen card: shown as soon as the assistant opens, for the
                 page the user is on. No question needed; the chips ask the
                 useful ones in one tap. -->
            <section t-if="state.screenCard and !state.screenCardDismissed"
                     class="o_ai_screen_card" aria-live="polite">
                <div class="o_ai_screen_card__head">
                    <i class="fa fa-map-marker" aria-hidden="true"/>
                    <span class="o_ai_screen_card__eyebrow" t-esc="labels.nowOn"/>
                    <strong class="o_ai_screen_card__title text-truncate" t-esc="state.screenCard.title"/>
                    <button type="button" class="o_ai_screen_card__close"
                            t-att-aria-label="labels.close" t-att-title="labels.close"
                            t-on-click="() => state.screenCardDismissed = true">
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>
                <p t-if="state.screenCard.about" class="o_ai_screen_card__about" t-esc="state.screenCard.about"/>
                <p t-if="(state.screenCard.lines or []).length" class="o_ai_screen_card__facts">
                    <t t-esc="state.screenCard.lines.join(' ')"/>
                </p>
                <div class="o_ai_screen_card__chips">
                    <button t-foreach="state.screenCard.suggestions or []" t-as="q" t-key="q_index"
                            type="button" class="o_ai_screen_card__chip"
                            t-att-disabled="state.isThinking"
                            t-on-click="() => this.askSuggestion(q)">
                        <t t-esc="q"/>
                    </button>
                </div>
            </section>

            <footer class="o_ai_agent_chat__footer">
                <form class="o_ai_agent_chat__form" t-on-submit.prevent="send">
                    <!-- One button for everything besides typing: opens a
                         circle of actions (voice, attach, scan, commands,
                         explain this screen). While listening it is the
                         stop button. Items come from composerActions. -->
                    <t t-set="composerItems" t-value="composerActions"/>
                    <div t-if="composerItems.length" class="o_ai_radial" t-ref="radial"
                         t-att-class="{ 'is-open': state.radialOpen, 'is-recording': state.recording }"
                         t-on-keydown="onRadialKeydown">
                        <div class="o_ai_radial__menu" role="menu"
                             t-att-aria-label="labels.whatDoYouNeed"
                             t-att-aria-hidden="state.radialOpen ? 'false' : 'true'">
                            <span class="o_ai_radial__center" t-esc="radialCenterLabel"/>
                            <button t-foreach="composerItems" t-as="item" t-key="item.id"
                                    type="button" role="menuitem" class="o_ai_radial__item"
                                    t-att-style="radialStyle(item_index, composerItems.length)"
                                    t-att-tabindex="state.radialOpen ? '0' : '-1'"
                                    t-att-aria-label="item.label" t-att-title="item.label"
                                    t-on-mouseenter="() => state.radialHover = item.label"
                                    t-on-focus="() => state.radialHover = item.label"
                                    t-on-mouseleave="() => state.radialHover = ''"
                                    t-on-click="() => this.pickComposerAction(item)">
                                <i t-attf-class="fa #{item.icon}" aria-hidden="true"/>
                            </button>
                        </div>
                        <button type="button" class="o_ai_radial__toggle"
                                t-att-disabled="state.transcribing or state.isThinking"
                                aria-haspopup="menu"
                                t-att-aria-expanded="state.radialOpen ? 'true' : 'false'"
                                t-att-aria-label="state.recording ? labels.stopRecording : labels.moreActions"
                                t-att-title="state.recording ? labels.stopRecording : labels.moreActions"
                                t-on-click="toggleRadial">
                            <i t-att-class="state.transcribing ? 'fa fa-spinner fa-spin' : state.recording ? 'fa fa-stop' : 'fa fa-plus'"
                               aria-hidden="true"/>
                            <span t-if="state.recording" class="o_ai_agent_chat__mic_pulse"/>
                        </button>
                    </div>
                    <textarea t-ref="textarea" class="o_ai_agent_chat__textarea"
                              t-model="state.input"
                              t-att-placeholder="state.transcribing ? labels.transcribing : state.recording ? labels.listening : placeholderText"
                              t-on-keydown="onInputKeydown"
                              rows="1"/>
                    <button class="o_ai_agent_chat__send" type="submit"
                            t-att-disabled="state.isThinking or !state.input.trim()">
                        <span t-if="!state.isThinking" t-esc="labels.ask"/>
                        <i t-if="state.isThinking" class="fa fa-spinner fa-spin"/>
                    </button>
                </form>
            </footer>

        </section>
    </t>

    <!-- Full-page wrapper for the client action. -->
    <t t-name="ab_ai_agent.AiAgentChatPage">
        <div class="o_ai_agent_chat_page">
            <div class="o_ai_agent_chat_page__inner">
                <AiAgentChat agentCode="params.agent_code"
                             surface="'chat'"
                             initialMessage="params.initial_message"
                             recordModel="params.record_model"
                             recordId="params.record_id"
                             conversationId="params.conversation_id"
                             enableVoice="!!params.enable_voice"/>
            </div>
        </div>
    </t>

</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Three-tier ACL: user / designer / manager.
         user      → invoke an agent, see own runs
         designer  → create / edit agents, topics, tools, skills
         manager   → see company-wide runs, manage budgets + price book -->
    <record id="module_category_ai_agent" model="ir.module.category">
        <field name="name">Ghaima AI</field>
        <field name="sequence">15</field>
    </record>

    <record id="group_ai_agent_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_ai_agent"/>
    </record>

    <record id="group_ai_agent_designer" model="res.groups">
        <field name="name">Agent Designer</field>
        <field name="category_id" ref="module_category_ai_agent"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_agent_user'))]"/>
    </record>

    <record id="group_ai_agent_manager" model="res.groups">
        <field name="name">AI Manager</field>
        <field name="category_id" ref="module_category_ai_agent"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_agent_designer'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Internal users get the user group by default so the chatbot
         keeps working without an explicit per-user assignment. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ai_agent_user'))]"/>
    </record>

    <!-- Run audit: users see own rows; managers see company-wide. -->
    <record id="rule_agent_run_user_own" model="ir.rule">
        <field name="name">Agent run: own rows only</field>
        <field name="model_id" ref="model_ai_agent_run"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_agent_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_agent_run_manager_all" model="ir.rule">
        <field name="name">Agent run: managers see company-wide</field>
        <field name="model_id" ref="model_ai_agent_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ai_agent_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Local usage log: same pattern. -->
    <record id="rule_usage_log_user_own" model="ir.rule">
        <field name="name">AI usage log: own rows</field>
        <field name="model_id" ref="model_ai_usage_local_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_agent_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_usage_log_manager_all" model="ir.rule">
        <field name="name">AI usage log: managers see company-wide</field>
        <field name="model_id" ref="model_ai_usage_local_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ai_agent_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Reconciliation cron — every 6h pushes unreconciled local rows
             to central, marks each as matched, raises a signal on drift. -->
        <record id="ir_cron_reconcile_usage" model="ir.cron">
            <field name="name">Ghaima AI: reconcile local usage with central audit</field>
            <field name="model_id" ref="model_ai_usage_local_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Price-book sync — nightly pulls central's current rates. -->
        <record id="ir_cron_sync_pricebook" model="ir.cron">
            <field name="name">Ghaima AI: sync price book from central</field>
            <field name="model_id" ref="model_ai_usage_price_book"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_pricebook()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Daily stats refresh — aggregates ai.agent.run into the
             denormalised stats fields on every agent. -->
        <record id="ir_cron_refresh_agent_stats" model="ir.cron">
            <field name="name">Ghaima AI: refresh per-agent stats</field>
            <field name="model_id" ref="model_ai_agent"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_stats()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- ERP knowledge digest: structure the assistant knows up front
             (cached prompt prefix). Nightly; also rebuilt on every -u. -->
        <record id="ir_cron_knowledge_digest" model="ir.cron">
            <field name="name">Ghaima AI: rebuild ERP knowledge digest</field>
            <field name="model_id" ref="model_ai_agent_knowledge_digest"/>
            <field name="state">code</field>
            <field name="code">model._cron_rebuild()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Weekly refresh of the ghaima.sa website excerpt (allow-listed
             hosts only; failure keeps the shipped knowledge). -->
        <record id="ir_cron_refresh_ghaima_website" model="ir.cron">
            <field name="name">Ghaima AI: refresh website knowledge</field>
            <field name="model_id" ref="model_ai_agent"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_ghaima_website()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <data noupdate="0">
        <function model="ai.agent.knowledge.digest" name="_schedule_rebuild"/>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Built-in: date reference. Always available, no business deps. -->
        <record id="tool_date_reference" model="ai.agent.tool">
            <field name="name">Date Reference</field>
            <field name="code">date_reference</field>
            <field name="category">retrieval</field>
            <field name="description">Returns a cheat-sheet of today's date plus common relative dates (yesterday, tomorrow, this week, last month, this quarter). Use this whenever the user mentions a relative timeframe — never compute relative dates yourself.</field>
            <field name="schema">{"type": "object", "properties": {}, "required": []}</field>
            <field name="dispatch_kind">python</field>
        </record>

        <!-- Built-in: echo (for golden-set tests). -->
        <record id="tool_echo" model="ai.agent.tool">
            <field name="name">Echo</field>
            <field name="code">echo</field>
            <field name="category">analysis</field>
            <field name="description">Returns its input as-is. Diagnostic tool; do not use in production answers.</field>
            <field name="schema">{"type": "object", "properties": {"input": {"type": "string"}}, "required": []}</field>
            <field name="dispatch_kind">python</field>
            <field name="active" eval="False"/>
        </record>

        <!-- ── Navigation tools ─────────────────────────────────── -->

        <record id="tool_open_record" model="ai.agent.tool">
            <field name="name">Open Record</field>
            <field name="code">open_record</field>
            <field name="category">navigation</field>
            <field name="description">Open a specific record in its form view. Use when the user names a specific entity — "open sale order 42", "show me invoice INV/2026/00045". Returns an action that paints an "Open" chip the user clicks to navigate.</field>
            <field name="schema">{"type": "object", "properties": {"model": {"type": "string", "description": "Technical model name (sale.order, account.move, crm.lead, ...)"}, "id": {"type": "number", "description": "Record id"}, "view_type": {"type": "string", "enum": ["form", "kanban", "list"], "default": "form"}}, "required": ["model", "id"]}</field>
            <field name="dispatch_kind">python</field>
            <field name="allow_end_message" eval="True"/>
        </record>

        <record id="tool_open_list" model="ai.agent.tool">
            <field name="name">Open List View</field>
            <field name="code">open_list</field>
            <field name="category">navigation</field>
            <field name="description">Open a filtered list view of a model. Use for "show me all overdue invoices", "list draft sale orders". Supports domain filters and group-by.</field>
            <field name="schema">{"type": "object", "properties": {"model": {"type": "string"}, "domain": {"type": "string", "description": "Odoo domain as a string, e.g. \"[('state','=','draft')]\""}, "group_by": {"type": "array", "items": {"type": "string"}}, "name": {"type": "string", "description": "Optional display label"}}, "required": ["model"]}</field>
            <field name="dispatch_kind">python</field>
            <field name="allow_end_message" eval="True"/>
        </record>

        <record id="tool_open_pivot" model="ai.agent.tool">
            <field name="name">Open Pivot View</field>
            <field name="code">open_pivot</field>
            <field name="category">navigation</field>
            <field name="description">Open an analytical pivot view. Use for "pivot sales by product and month", "breakdown of expenses by department". Specify measures + row/column groupbys.</field>
            <field name="schema">{"type": "object", "properties": {"model": {"type": "string"}, "measures": {"type": "array", "items": {"type": "string"}}, "row_groupbys": {"type": "array", "items": {"type": "string"}}, "col_groupbys": {"type": "array", "items": {"type": "string"}}, "domain": {"type": "string"}, "name": {"type": "string"}}, "required": ["model"]}</field>
            <field name="dispatch_kind">python</field>
            <field name="allow_end_message" eval="True"/>
        </record>

        <record id="tool_open_graph" model="ai.agent.tool">
            <field name="name">Open Graph View</field>
            <field name="code">open_graph</field>
            <field name="category">navigation</field>
            <field name="description">Open a chart view — bar / line / pie. Use for "chart sales by month", "pie chart of customers by country". One measure + group-by field, plus mode.</field>
            <field name="schema">{"type": "object", "properties": {"model": {"type": "string"}, "measure": {"type": "string"}, "mode": {"type": "string", "enum": ["bar", "line", "pie"], "default": "bar"}, "group_by": {"type": "array", "items": {"type": "string"}}, "domain": {"type": "string"}, "name": {"type": "string"}}, "required": ["model"]}</field>
            <field name="dispatch_kind">python</field>
            <field name="allow_end_message" eval="True"/>
        </record>

        <record id="tool_open_action" model="ai.agent.tool">
            <field name="name">Open Action by XMLID</field>
            <field name="code">open_action</field>
            <field name="category">navigation</field>
            <field name="description">Open any server-registered action by its xmlid. Use for built-in reports: 'account.action_account_pl_report' for P&amp;L, 'account.action_account_balance_report' for balance sheet, 'sale.action_orders' for sales list. Also works for any module-defined action.</field>
            <field name="schema">{"type": "object", "properties": {"xmlid": {"type": "string", "description": "Full xmlid like 'account.action_account_pl_report'"}}, "required": ["xmlid"]}</field>
            <field name="dispatch_kind">python</field>
            <field name="allow_end_message" eval="True"/>
        </record>

        <!-- ── HR domain tools (gated by hr / hr.attendance presence) ── -->

        <record id="tool_hr_attendance_missing_today" model="ai.agent.tool">
            <field name="name">HR: Missing Check-ins Today</field>
            <field name="code">hr_attendance_missing_today</field>
            <field name="category">retrieval</field>
            <field name="description">List of active employees who have NOT checked in for the day yet — the "who's not at work today" roll call. Returns count + per-employee rows with department and job title.</field>
            <field name="schema">{"type": "object", "properties": {"limit": {"type": "number", "default": 50}}, "required": []}</field>
            <field name="dispatch_kind">python</field>
            <field name="requires_pii" eval="True"/>
        </record>

        <record id="tool_hr_leave_pending" model="ai.agent.tool">
            <field name="name">HR: Pending Leave Requests</field>
            <field name="code">hr_leave_pending</field>
            <field name="category">retrieval</field>
            <field name="description">List leave requests awaiting approval. Returns count + per-request rows with employee, type, date range, day count.</field>
            <field name="schema">{"type": "object", "properties": {"limit": {"type": "number", "default": 50}}, "required": []}</field>
            <field name="dispatch_kind">python</field>
            <field name="requires_pii" eval="True"/>
        </record>

        <record id="tool_hr_attendance_open_shifts" model="ai.agent.tool">
            <field name="name">HR: Currently Clocked-In</field>
            <field name="code">hr_attendance_open_shifts</field>
            <field name="category">retrieval</field>
            <field name="description">Employees who clocked in but haven't clocked out yet. Useful for end-of-day exit reminders.</field>
            <field name="schema">{"type": "object", "properties": {}, "required": []}</field>
            <field name="dispatch_kind">python</field>
            <field name="requires_pii" eval="True"/>
        </record>

        <!-- ── Analysis ─────────────────────────────────────────── -->

        <record id="tool_data_analysis" model="ai.agent.tool">
            <field name="name">Data Analysis (timeseries + chart)</field>
            <field name="code">data_analysis</field>
            <field name="category">analysis</field>
            <field name="description">Aggregate a business metric over time and return a ready-made chart, KPI grid and peak callout. Numbers are computed from the database — accurate, never estimated. Use this for ANY "trend / over time / how are X doing / compare to last period / breakdown by day-week-month" question about sales. metric: pos_sales (Point of Sale), sale_orders (sales orders), invoiced_revenue (posted customer invoices). period_days 1-365. group day|week|month. Do NOT restate the returned table in prose — write one short paragraph interpreting it.</field>
            <field name="schema">{"type": "object", "properties": {"metric": {"type": "string", "enum": ["pos_sales", "sale_orders", "invoiced_revenue"], "default": "pos_sales"}, "period_days": {"type": "number", "default": 30, "description": "Lookback window in days (1-365)"}, "group": {"type": "string", "enum": ["day", "week", "month"], "default": "day"}}, "required": []}</field>
            <field name="dispatch_kind">python</field>
        </record>

    </data>
</odoo>

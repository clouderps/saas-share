<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_usage_price_book_list" model="ir.ui.view">
        <field name="name">ai.usage.price.book.list</field>
        <field name="model">ai.usage.price.book</field>
        <field name="arch" type="xml">
            <list string="AI Price Book" editable="bottom"
                  decoration-success="markup_pct &gt; 0" decoration-muted="not is_published">
                <field name="provider"/>
                <field name="model_name"/>
                <field name="model_class"/>
                <field name="provider_input_per_1k_usd"/>
                <field name="provider_output_per_1k_usd"/>
                <field name="billed_input_per_1k_sar"/>
                <field name="billed_output_per_1k_sar"/>
                <field name="markup_pct" string="Markup %"/>
                <field name="fx_usd_to_sar"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_ai_usage_price_book" model="ir.actions.act_window">
        <field name="name">AI Price Book</field>
        <field name="res_model">ai.usage.price.book</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

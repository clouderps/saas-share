<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_skill_list" model="ir.ui.view">
        <field name="name">ai.agent.skill.list</field>
        <field name="model">ai.agent.skill</field>
        <field name="arch" type="xml">
            <list string="Skills">
                <field name="sequence" widget="handle"/>
                <field name="agent_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="icon"/>
                <field name="accent"/>
                <field name="surfaces"/>
                <field name="run_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_ai_agent_skill" model="ir.actions.act_window">
        <field name="name">Agent Skills</field>
        <field name="res_model">ai.agent.skill</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_agent_list" model="ir.ui.view">
        <field name="name">ai.agent.list</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <list string="AI Agents" decoration-info="persona == 'assistant'"
                  decoration-success="persona == 'coach'" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="persona"/>
                <field name="model_class"/>
                <field name="run_count" string="Runs (30d)"/>
                <field name="success_rate" widget="percentage" string="Success"/>
                <field name="avg_cost_usd" string="Avg cost (USD)" widget="monetary"/>
                <field name="last_run_at"/>
                <field name="is_system" string="System" widget="boolean"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_agent_form" model="ir.ui.view">
        <field name="name">ai.agent.form</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <form string="AI Agent">
                <header>
                    <button name="open_chat" type="object" class="btn-primary"
                            string="Open Chat" icon="fa-comments-o"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="System Agent"
                            bg_color="text-bg-info" invisible="not is_system"/>
                    <field name="avatar" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Sales Coach"/>
                        </h1>
                        <h3>
                            <field name="code" placeholder="sales_coach" readonly="is_system"/>
                        </h3>
                        <field name="description" placeholder="One-line description of this agent's purpose..."/>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="persona"/>
                            <field name="locale"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Behaviour">
                            <field name="response_style"/>
                            <field name="model_class"/>
                            <field name="max_hops"/>
                            <field name="max_cost_usd" widget="monetary"/>
                        </group>
                        <group string="Permissions">
                            <field name="allow_pii"/>
                            <field name="allow_write_actions"/>
                            <field name="allow_web_grounding"/>
                            <field name="is_public"/>
                        </group>
                        <group string="Performance (30 days)">
                            <field name="run_count" readonly="1"/>
                            <field name="success_rate" widget="percentage" readonly="1"/>
                            <field name="avg_cost_usd" readonly="1" widget="monetary"/>
                            <field name="total_cost_30d_usd" readonly="1" widget="monetary"/>
                            <field name="last_run_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="System Prompt">
                            <field name="system_prompt"
                                   placeholder="# Identity&#10;You are a..."/>
                        </page>
                        <page string="Topics &amp; Tools">
                            <group>
                                <field name="topic_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="tool_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       help="Tools attached directly (in addition to topic tools)."/>
                            </group>
                            <separator string="Effective tool set (topics + direct)"/>
                            <field name="all_tool_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category"/>
                                    <field name="is_write_action" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                        <page string="Skills" name="skills">
                            <field name="skill_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="surfaces"/>
                                    <field name="icon"/>
                                    <field name="accent"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="code"/>
                                                <field name="icon"/>
                                                <field name="accent"/>
                                                <field name="surfaces"/>
                                                <field name="requires_record_context"/>
                                            </group>
                                            <group string="KPI linkage">
                                                <field name="kpi_label"/>
                                                <field name="kpi_target_text"/>
                                                <field name="run_count" readonly="1"/>
                                                <field name="avg_cost_usd" readonly="1"/>
                                            </group>
                                        </group>
                                        <separator string="Prompt template"/>
                                        <field name="user_prompt_template"
                                               placeholder="Qualify lead {lead_id}: produce a 1-100 score and a 2-sentence rationale..."/>
                                        <separator string="Description"/>
                                        <field name="description"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Distribution">
                            <group>
                                <group>
                                    <field name="surface_ids"/>
                                </group>
                                <group>
                                    <field name="company_ids" widget="many2many_tags"/>
                                    <field name="user_group_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_agent_kanban" model="ir.ui.view">
        <field name="name">ai.agent.kanban</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_ai_agent_kanban" default_order="sequence,name">
                <field name="name"/>
                <field name="code"/>
                <field name="persona"/>
                <field name="description"/>
                <field name="model_class"/>
                <field name="run_count"/>
                <field name="success_rate"/>
                <field name="active"/>
                <field name="is_system"/>
                <templates>
                    <t t-name="card" class="oe_kanban_global_click p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="o_ai_agent_avatar">
                                <img t-att-src="kanban_image('ai.agent', 'avatar', record.id.raw_value)"
                                     class="o_avatar rounded" alt="Agent avatar"/>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong class="fs-5"><field name="name"/></strong>
                                    <span t-if="record.is_system.raw_value" class="badge bg-info">System</span>
                                </div>
                                <div class="text-muted small mt-1"><field name="description"/></div>
                                <div class="d-flex gap-3 mt-3 small text-muted">
                                    <span><i class="fa fa-bolt me-1"/><field name="model_class"/></span>
                                    <span><i class="fa fa-play me-1"/><field name="run_count"/> runs</span>
                                    <span><i class="fa fa-check me-1"/><field name="success_rate"/>%</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ai_agent_search" model="ir.ui.view">
        <field name="name">ai.agent.search</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="system" string="System agents" domain="[('is_system', '=', True)]"/>
                <filter name="public" string="Public-facing" domain="[('is_public', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_persona" string="Persona" context="{'group_by': 'persona'}"/>
                    <filter name="group_model_class" string="Model class" context="{'group_by': 'model_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">ai.agent</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smile">Design a new agent.</p>
            <p>Agents are personas with a system prompt, a set of topics + tools, and a list of skills users can invoke.</p>
        </field>
    </record>

</odoo>

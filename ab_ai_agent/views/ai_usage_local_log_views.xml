<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_usage_local_log_list" model="ir.ui.view">
        <field name="name">ai.usage.local.log.list</field>
        <field name="model">ai.usage.local.log</field>
        <field name="arch" type="xml">
            <list string="AI Usage (this instance)" create="0"
                  decoration-info="cache_hit" decoration-muted="routed_via == 'sim'"
                  decoration-danger="status == 'error'">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="agent_id"/>
                <field name="surface"/>
                <field name="provider"/>
                <field name="model_used"/>
                <field name="routed_via"/>
                <field name="cache_hit" widget="boolean"/>
                <field name="prompt_tokens"/>
                <field name="completion_tokens"/>
                <field name="total_tokens" sum="Total tokens"/>
                <field name="est_cost_usd" widget="monetary" sum="USD"/>
                <field name="est_cost_billable" widget="monetary" sum="SAR (billable)"/>
                <field name="status"/>
                <field name="reconciled_with_central" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_ai_usage_local_log_search" model="ir.ui.view">
        <field name="name">ai.usage.local.log.search</field>
        <field name="model">ai.usage.local.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="user_id"/>
                <field name="model_used"/>
                <field name="request_id"/>
                <filter name="today" string="Today"
                        domain="[('timestamp', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="month" string="This month"
                        domain="[('timestamp', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="cache_hit" string="Cache hits" domain="[('cache_hit', '=', True)]"/>
                <filter name="errors" string="Errors" domain="[('status', '!=', 'ok')]"/>
                <filter name="unreconciled" string="Not reconciled" domain="[('reconciled_with_central', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_surface" string="Surface" context="{'group_by': 'surface'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_used'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ai_usage_local_log_graph" model="ir.ui.view">
        <field name="name">ai.usage.local.log.graph</field>
        <field name="model">ai.usage.local.log</field>
        <field name="arch" type="xml">
            <graph string="AI Usage" type="bar" sample="1">
                <field name="agent_id" type="row"/>
                <field name="est_cost_billable" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ai_usage_local_log" model="ir.actions.act_window">
        <field name="name">AI Cost Center</field>
        <field name="res_model">ai.usage.local.log</field>
        <field name="view_mode">graph,list</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- Local budget views -->
    <record id="view_ai_usage_local_budget_list" model="ir.ui.view">
        <field name="name">ai.usage.local.budget.list</field>
        <field name="model">ai.usage.local.budget</field>
        <field name="arch" type="xml">
            <list string="AI Budgets"
                  decoration-success="state == 'ok'"
                  decoration-warning="state == 'warn'"
                  decoration-danger="state == 'blocked'">
                <field name="name"/>
                <field name="scope"/>
                <field name="user_id" invisible="scope != 'user'"/>
                <field name="agent_id" invisible="scope != 'agent'"/>
                <field name="surface" invisible="scope != 'surface'"/>
                <field name="daily_sar"/>
                <field name="monthly_sar"/>
                <field name="used_today_sar"/>
                <field name="used_month_sar"/>
                <field name="state"/>
                <field name="enforce" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_usage_local_budget_form" model="ir.ui.view">
        <field name="name">ai.usage.local.budget.form</field>
        <field name="model">ai.usage.local.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="scope"/>
                            <field name="user_id" invisible="scope != 'user'"/>
                            <field name="agent_id" invisible="scope != 'agent'"/>
                            <field name="surface" invisible="scope != 'surface'"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Limits (SAR)">
                            <field name="daily_sar"/>
                            <field name="monthly_sar"/>
                            <field name="warn_at"/>
                            <field name="enforce"/>
                        </group>
                        <group string="Used">
                            <field name="used_today_sar" readonly="1"/>
                            <field name="used_month_sar" readonly="1"/>
                            <field name="remaining_daily_sar" readonly="1"/>
                            <field name="remaining_monthly_sar" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_usage_local_budget" model="ir.actions.act_window">
        <field name="name">AI Budgets</field>
        <field name="res_model">ai.usage.local.budget</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mcp_token_own" model="ir.rule">
        <field name="name">MCP token: own rows</field>
        <field name="model_id" ref="model_mcp_token"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_mcp_token_admin" model="ir.rule">
        <field name="name">MCP token: administrators see all</field>
        <field name="model_id" ref="model_mcp_token"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_mcp_call_log_own" model="ir.rule">
        <field name="name">MCP call log: own rows</field>
        <field name="model_id" ref="model_mcp_call_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_mcp_call_log_manager" model="ir.rule">
        <field name="name">MCP call log: AI managers see company-wide</field>
        <field name="model_id" ref="model_mcp_call_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        <field name="groups" eval="[(4, ref('ab_ai_agent.group_ai_agent_manager'))]"/>
    </record>
</odoo>
